{
  "name": "komari-btop-minimal",
  "private": true,
  "version": "1.5.2",
  "type": "module",
  "license": "MIT",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=22.12.0 <25",
    "npm": ">=10 <12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yt1988/komari-btop-minimal.git"
  },
  "bugs": {
    "url": "https://github.com/yt1988/komari-btop-minimal/issues"
  },
  "homepage": "https://github.com/yt1988/komari-btop-minimal#readme",
  "scripts": {
    "dev": "npm run prepare:flags && vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test",
    "build": "npm run prepare:flags && vite build",
    "prepare:flags": "node scripts/prepare-flags.mjs",
    "package": "npm run check && npm run build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "archiver": "8.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "flag-icons": "7.5.0"
  }
}
